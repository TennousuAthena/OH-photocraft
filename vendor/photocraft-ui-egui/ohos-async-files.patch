+pub(crate) fn published(app: &mut PhotocraftApp, ctx: &egui::Context, document: u64, revision: u64) {
+    let waiting = app.discard.as_ref().and_then(|prompt| prompt.docs.first()).is_some_and(|id| id.0 == document);
+    let clean = app.session.documents().iter().find(|st| st.doc.id.0 == document).is_some_and(|st| st.revision == revision && !st.is_dirty());
+    if waiting && clean {
+        advance(app, ctx);
+    }
+}
